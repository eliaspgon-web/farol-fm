# Copie para .env e preencha
PORT=3000
# URL pública deste backend (o Mercado Pago envia as confirmações para PUBLIC_URL/api/webhooks/mercadopago)
PUBLIC_URL=https://api.farolradiotv.com.br
# Domínio(s) do site, separados por vírgula
SITE_ORIGIN=https://farolradiotv.com.br
# Gere um segredo longo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=admin@farolradiotv.com.br
# Preferível: hash bcrypt (npm run hash -- "sua-senha")
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Mercado Pago > Suas integrações > Credenciais (Access Token). Use TEST-... para homologar.
MP_ACCESS_TOKEN=
# Mercado Pago > Webhooks > Assinatura secreta
MP_WEBHOOK_SECRET=
# YouTube: a live do canal (ID em Painel > Redes sociais) é detectada automaticamente a cada 3 min.
# Opcional: chave da YouTube Data API v3 (mais oficial; consulta a cada 15 min por causa da cota)
YT_API_KEY=
# YT_CHECK_MIN=3

# Instagram @radiotvfarol: token de longa duração da "API do Instagram com login do Instagram"
# (conta profissional Criador/Empresa). O servidor renova o token sozinho a cada 7 dias.
IG_ACCESS_TOKEN=

# ---------------- WhatsApp (API oficial da Meta — WhatsApp Cloud API) ----------------
# developers.facebook.com > Seu app > WhatsApp > Configuração da API
WA_TOKEN=
WA_PHONE_ID=
# Webhook: URL = PUBLIC_URL/api/whatsapp/webhook  |  Token de verificação = o valor abaixo  |  campo: messages
WA_VERIFY_TOKEN=farol-verifica
WA_APP_SECRET=
# Números dos vendedores que recebem aviso de cliente na fila (separados por vírgula)
WA_VENDEDORES=
# Endereço público do site (para os links "comprar agora" enviados pelo robô)
SITE_URL=https://farolradiotv.com.br

# ---------------- Agente com IA (opcional) ----------------
# Responde perguntas livres usando só o catálogo e as regras da loja; chama um vendedor quando precisa.
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
